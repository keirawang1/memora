# Supabase — find these in Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in: enable the Google provider in Supabase Dashboard → Authentication → Providers.
# Add your Google Cloud OAuth Client ID + Secret there. Automatic identity linking merges
# Google with an existing email/password account when the verified emails match.
# Also add your site URL (and /sign-in) under Authentication → URL Configuration → Redirect URLs.

# TMDB (client trending for movies/TV) — free key from themoviedb.org
VITE_TMDB_API_KEY=

# Server-only (never VITE_)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# TMDB_API_KEY=
# Embeddings: free local MiniLM in services/recommendations (no Gemini)
